<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="using:AssemblySearch.Desktop.Presentation" x:Class="AssemblySearch.Desktop.MainWindow" x:CompileBindings="False" Title="Assembly Search" Width="1280" Height="800" MinWidth="1000" MinHeight="650">
 <Window.Resources><ui:FileNameConverter x:Key="FileName"/></Window.Resources>
 <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
   <StackPanel><TextBlock Text="Assembly Search" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Inspect .NET assemblies · search metadata and IL" Opacity="0.65" FontSize="13" Margin="0,4,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Name="OpenButton" Content="Open assemblies…"/><Button Name="ExportButton" Content="Export JSON…" IsEnabled="False"/><Button Name="CancelButton" Content="Cancel" IsEnabled="False"/></StackPanel>
  </Grid>
  <StackPanel Grid.Row="1" Spacing="10" Margin="0,0,0,16">
   <Grid ColumnDefinitions="*,Auto,Auto"><TextBox Name="QueryBox" PlaceholderText="Search names, /regex/, or typed literals" MaxLength="4096" AutomationProperties.Name="Search query"/><Button Grid.Column="1" Name="ClearButton" Content="Clear" Margin="8,0,0,0" IsVisible="False"/><Button Grid.Column="2" Name="SearchButton" Content="Search" Margin="8,0,0,0"/></Grid>
   <WrapPanel Orientation="Horizontal">
    <StackPanel Margin="0,0,12,8"><TextBlock Text="Category" FontSize="12" Margin="0,0,0,4"/><ComboBox Name="CategoryBox" Width="190" AutomationProperties.Name="Search category"/></StackPanel>
    <StackPanel Margin="0,0,12,8"><TextBlock Text="Mode" FontSize="12" Margin="0,0,0,4"/><ComboBox Name="ModeBox" Width="130" AutomationProperties.Name="Matching mode"/></StackPanel>
    <StackPanel Margin="0,0,12,8"><TextBlock Text="Scope" FontSize="12" Margin="0,0,0,4"/><ComboBox Name="ScopeBox" Width="140" AutomationProperties.Name="Search scope"/></StackPanel>
    <StackPanel Margin="0,0,12,8"><TextBlock Text="Result limit" FontSize="12" Margin="0,0,0,4"/><NumericUpDown Name="LimitBox" Minimum="1" Maximum="100000" Value="10000" Width="150" FormatString="0" AutomationProperties.Name="Result limit"/></StackPanel>
    <StackPanel Name="TypePanel" IsVisible="False" Margin="0,0,0,8"><TextBlock Text="Qualified type" FontSize="12" Margin="0,0,0,4"/><TextBox Name="TypeBox" Width="240" PlaceholderText="Namespace.Type / nested type" AutomationProperties.Name="Qualified type scope"/></StackPanel>
   </WrapPanel>
   <WrapPanel Orientation="Horizontal"><CheckBox Name="CaseBox" Content="Case sensitive" Margin="0,0,16,0"/><CheckBox Name="ExactBox" Content="Exact candidate" Margin="0,0,16,0" ToolTip.Tip="Compare the entire name or string value, rather than substrings."/><CheckBox Name="AnyBox" Content="Any term (OR)" Margin="0,0,16,0"/><CheckBox Name="GeneratedBox" Content="Generated members" Margin="0,0,16,0"/><CheckBox Name="FrameworkBox" Content="Framework assemblies" IsChecked="True" Margin="0,0,16,0"/><CheckBox Name="AttributesBox" Content="Attributes" Margin="0,0,16,0"/><CheckBox Name="ResourcesBox" Content="Resource contents" IsChecked="True"/></WrapPanel>
  </StackPanel>
  <Grid Grid.Row="2" ColumnDefinitions="240,6,*,6,*" RowDefinitions="*">
   <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="10"><Grid RowDefinitions="Auto,*,Auto"><TextBlock Name="AssemblyCountText" Text="Loaded assemblies" FontWeight="SemiBold" Margin="0,0,0,8"/><ListBox Grid.Row="1" Name="LoadedList" SelectionMode="Multiple" AutomationProperties.Name="Loaded assemblies"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource FileName}}" ToolTip.Tip="{Binding}" TextTrimming="CharacterEllipsis" Margin="0,5"/></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="2" Spacing="6" Margin="0,8,0,0"><TextBlock Text="Ctrl / Shift selects multiple files." FontSize="11" Opacity="0.65"/><Button Name="RemoveButton" Content="Remove selected" HorizontalAlignment="Stretch"/></StackPanel></Grid></Border>
   <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent"/>
   <Border Grid.Column="2" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="10"><Grid RowDefinitions="Auto,*,Auto"><TextBlock Name="ResultCountText" Text="Results" FontWeight="SemiBold" Margin="0,0,0,8"/><ListBox Grid.Row="1" Name="ResultsList" AutomationProperties.Name="Search results"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2,6" Spacing="3"><TextBlock Text="{Binding Candidate.DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Candidate.DeclaringMember}" FontSize="12" Opacity="0.8" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Candidate.DeclaringType}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Candidate.Kind}" FontSize="11" Opacity="0.55"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Grid.Row="2" Name="EmptyText" Text="Open assemblies, then enter a search query." TextWrapping="Wrap" Opacity="0.65" Margin="0,8,0,0"/></Grid></Border>
   <GridSplitter Grid.Column="3" ResizeDirection="Columns" Background="Transparent"/>
   <Border Grid.Column="4" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="10"><Grid RowDefinitions="Auto,*,Auto,110"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Identity &amp; IL context" FontWeight="SemiBold" Margin="0,0,0,8"/><Button Grid.Column="1" Name="CopyButton" Content="Copy" IsEnabled="False"/></Grid><TextBox Grid.Row="1" Name="ContextBox" Text="Select a result to inspect its metadata and instruction context." IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="monospace" FontSize="13" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Result identity and IL context"/><TextBlock Grid.Row="2" Text="Diagnostics &amp; coverage" FontWeight="SemiBold" Margin="0,10,0,6"/><TextBox Grid.Row="3" Name="DiagnosticsBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontSize="12" AutomationProperties.Name="Search diagnostics"/></Grid></Border>
  </Grid>
  <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,12,0,0"><TextBlock Name="StatusText" Text="Ready · input assemblies are never executed" VerticalAlignment="Center"/><ProgressBar Grid.Column="1" Name="SearchProgress" IsIndeterminate="True" Width="140" Height="4" IsVisible="False"/></Grid>
 </Grid>
</Window>
